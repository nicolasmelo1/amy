{
  "name": "amy-workspace",
  "version": "0.1.0",
  "description": "A state machine that runs under your agent harnesses, where every part of it is a plugin you assemble for the work you actually do.",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "tsc --build",
    "clean": "tsc --build --clean",
    "dev": "npm run --workspace @amy/cli dev",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "audit": "npm audit --audit-level=high",
    "check:release": "node scripts/check-release-config.mjs",
    "gate": "npm run build && npm run typecheck && npm run check:release && npm run docs:check && npm run test:coverage && npm run lint && npm run knip && npm run audit && sf check --allow-commands && sf verify",
    "e2e": "./.software-factory/evidence/plugin-file-queue-scenario.sh && ./.software-factory/evidence/plugin-agent-relay-scenario.sh && ./.software-factory/evidence/plugin-serial-engine-scenario.sh && ./.software-factory/evidence/installed-binary-scenario.sh && ./.software-factory/evidence/installed-plugins-scenario.sh && ./.software-factory/evidence/ticket-to-qa-scenario.sh && ./.software-factory/evidence/note-to-plan-scenario.sh",
    "changeset": "changeset",
    "release:version": "changeset version && npm install --package-lock-only",
    "release:publish": "npm run build && changeset publish",
    "install:local": "./scripts/install.sh",
    "knip": "knip",
    "bench": "vitest bench --run --compare=packages/core/tests/bench-baseline.json",
    "bench:baseline": "vitest bench --run --outputJson=packages/core/tests/bench-baseline.json",
    "typecheck": "tsc --noEmit -p tsconfig.tests.json",
    "docs:generate": "node scripts/docs/generate.mjs",
    "docs:check": "node scripts/docs/generate.mjs --check",
    "docs:changelog": "node scripts/docs/changelog.mjs",
    "docs:draft": "node scripts/docs/draft.mjs"
  },
  "devDependencies": {
    "@changesets/cli": "^3.0.2",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.10",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "eslint-plugin-security": "^4.0.1",
    "knip": "^6.34.0",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.69.0",
    "vitest": "4.1.11",
    "yaml": "^2.8.1"
  },
  "workspaces": [
    "packages/*",
    "plugins/*"
  ],
  "knip": {
    "ignore": [
      ".software-factory/**",
      "scripts/write-install-manifest.mjs"
    ],
    "ignoreBinaries": [
      "sf"
    ]
  }
}
