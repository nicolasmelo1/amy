{
  "name": "@amykit/cli",
  "version": "0.6.0",
  "description": "The amy command line: one install per machine, reached from any harness.",
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.18.0"
  },
  "author": "Nicolas Melo",
  "homepage": "https://github.com/nicolasmelo1/amy#readme",
  "bugs": "https://github.com/nicolasmelo1/amy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasmelo1/amy.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepack": "tsx ../../scripts/write-stamp.ts",
    "postpack": "node -e \"require('node:fs').rmSync('dist/stamp.json', {force: true})\""
  },
  "bin": {
    "amy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "guardrails"
  ],
  "dependencies": {
    "@amykit/core": "^0.6.0",
    "@amykit/model-specs": "^0.6.0",
    "@amykit/plugin-file-log": "^0.6.0",
    "@amykit/plugin-file-notes": "^0.6.0",
    "@amykit/plugin-file-queue": "^0.6.0",
    "@amykit/plugin-file-store": "^0.6.0",
    "@amykit/plugin-file-tasks": "^0.6.0",
    "@amykit/plugin-file-worktree": "^0.6.0",
    "@amykit/ui": "^0.6.0",
    "commander": "^14.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@amykit/plugin-serial-engine": "^0.6.0",
    "@amykit/test-fixtures": "^0.1.0",
    "@amykit/workflow-errand": "^0.6.0",
    "@amykit/workflow-note-to-plan": "^0.6.0",
    "pele": "^1.12.0"
  }
}
