{
  "name": "@amy/cli",
  "version": "0.1.0",
  "description": "The amy command line.",
  "type": "module",
  "license": "MIT",
  "author": "Nicolas Melo",
  "homepage": "https://github.com/nicolasmelo1/amy#readme",
  "bugs": "https://github.com/nicolasmelo1/amy/issues",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nicolasmelo1/amy.git",
    "directory": "packages/cli"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org"
  },
  "scripts": {
    "prepack": "node ../../scripts/write-stamp.mjs",
    "postpack": "node -e \"require('node:fs').rmSync('dist/stamp.json', {force: true})\""
  },
  "bin": {
    "amy": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "skills",
    "capabilities.yaml"
  ],
  "dependencies": {
    "@amy/core": "^0.1.0",
    "@amy/model-specs": "^0.1.0",
    "@amy/plugin-file-log": "^0.1.0",
    "@amy/plugin-file-notes": "^0.1.0",
    "@amy/plugin-file-queue": "^0.1.0",
    "@amy/plugin-file-store": "^0.1.0",
    "@amy/plugin-file-tasks": "^0.1.0",
    "@amy/plugin-notify-hermes": "^0.1.0",
    "@amy/workflow-ticket-to-qa": "^0.1.0",
    "commander": "^14.0.0",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@amy/plugin-serial-engine": "^0.1.0",
    "@amy/test-fixtures": "^0.1.0",
    "@amy/workflow-errand": "^0.1.0",
    "@amy/workflow-note-to-plan": "^0.1.0"
  }
}
