stateDiagram-v2
    %% A piece of friction becomes a plan on a pull request, or is handed back.
    %% NOTED waits only when the ceiling on plans in flight is reached; nothing
    %% here waits on a person, because the pull request at the end is somebody
    %% else's to merge. PR_OPEN calls the shipped pull-request workflow, and
    %% leaves on the end it reached.
    classDef waiting stroke-dasharray: 4 4

    [*] --> NOTED
    NOTED --> DRAFTED
    DRAFTED --> CHECKED
    CHECKED --> DRAFTED: check is red
    CHECKED --> PR_OPEN
    state "open the pull request · @amykit/workflow-pull-request" as PR_OPEN
    PR_OPEN --> DONE: OPENED
    PR_OPEN --> DECLINED: REFUSED
    NOTED --> DECLINED: not a repository I write into
    DRAFTED --> DECLINED: no draft in the attempts allowed
    DONE --> [*]
    DECLINED --> [*]

    class NOTED waiting
    class PR_OPEN call
